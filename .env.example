# =============================================================================
# DocuEase environment variables
# Copy to .env (backend) or set them in your hosting provider's dashboard.
# Never commit real keys.
# =============================================================================

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed browser origins. In production this MUST be
# the deployed frontend origin, e.g. https://docuease.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider: local Ollama ---------------------------------------------
# "ollama" (local, no per-request fees) or "openai_compatible" (any hosted
# OpenAI-style /chat/completions endpoint such as Groq or OpenRouter).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:1.5b is fast and low-RAM. Stronger: qwen2.5:7b, llama3.1:8b.
# Avoid qwen3 "thinking" models unless you disable thinking: they spend the
# whole token budget on reasoning and return empty/slow answers.
OLLAMA_MODEL=qwen2.5:1.5b

# --- AI provider: hosted OpenAI-compatible endpoint --------------------------
# Groq free tier (no credit card): https://api.groq.com/openai/v1
# OpenRouter free models:         https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
AI_MODEL=llama-3.1-8b-instant

# --- Free-tier resource limits (server-enforced) ----------------------------
MAX_UPLOAD_BYTES=5242880          # 5 MB
MAX_EXTRACTED_CHARS=20000         # characters per generation (rejected, not truncated)
MAX_GENERATIONS_PER_SESSION=3
MAX_CONCURRENT_GENERATIONS_PER_SESSION=1
GENERATION_COOLDOWN_SECONDS=15
MAX_OUTPUT_TOKENS=1000
RATE_LIMIT_REQUESTS=30            # per client IP per window
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_CONNECT_TIMEOUT_SECONDS=5

# --- Optional persistent quota store ---------------------------------------
# Set to a path on a PERSISTENT disk (e.g. /var/data/quota.sqlite) to survive
# restarts. Leave empty for in-memory quotas. Render's free disk is ephemeral.
QUOTA_DB_PATH=

# --- Text-to-speech --------------------------------------------------------
# Browser SpeechSynthesis is always available for playback. This flag enables
# the optional server-side MP3 download (gTTS, no API key).
TTS_ENABLED=true
TTS_MAX_CHARS=4000

# --- Demo mode -------------------------------------------------------------
DEMO_ENABLED=true

# =============================================================================
# Frontend (put this in frontend/.env.local, or Vercel project settings)
# Absolute backend URL. Empty = same origin (Vite dev proxy).
# Example: https://docuease-api.onrender.com
# =============================================================================
VITE_API_BASE_URL=
