# Copy to frontend/.env.local for local development, or set this in your
# static host's environment settings (Vercel → Settings → Environment Variables).
#
# Absolute URL of the FastAPI backend. Leave empty to use the Vite dev proxy
# (http://127.0.0.1:8000) during local development.
#
# Example for Render:
#   VITE_API_BASE_URL=https://docuease-api.onrender.com
VITE_API_BASE_URL=
